rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Allow read and write for all collections in this application
    match /products/{productId} {
      allow read, write: if true;
    }

    match /orders/{orderId} {
      allow read, write: if true;
    }

    match /custom_orders/{customOrderId} {
      allow read, write: if true;
    }

    match /ai_faqs/{faqId} {
      allow read, write: if true;
    }

    match /ai_conversations/{convId} {
      allow read, write: if true;
    }

    match /payment_details/{docId} {
      allow read, write: if true;
    }

    match /users/{userId} {
      allow read, write: if true;
    }

    match /{document=**} {
      allow read, write: if true;
    }
  }
}

